# Web/API server
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_API_KEY=
WEB_CORS_ORIGINS=

# Queue and processing runtime
# VSR_PYTHON=/absolute/path/to/.venv/bin/python
VSR_DATA_DIR=./web_data
VSR_FFMPEG_PATH=
VSR_MAX_UPLOAD_BYTES=2147483648
VSR_QUEUE_SIZE=8
VSR_MAX_JOBS=100

# Optional model and runtime settings
PADDLE_PDX_MODEL_SOURCE=BOS
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
CUDA_MODULE_LOADING=LAZY
PYTHONUNBUFFERED=1
